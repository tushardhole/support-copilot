# ── LLM ──────────────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint (OpenAI, Azure OpenAI, Ollama, vLLM, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...

# Chat model used for generation
LLM_MODEL=gpt-4o-mini

# Max tokens for a single LLM response
LLM_MAX_TOKENS=2048

# Temperature (0 = deterministic, 1 = creative)
LLM_TEMPERATURE=0.0

# ── Embeddings ────────────────────────────────────────────────────────────────
# "openai" → calls embeddings endpoint | "local" → sentence-transformers
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small

# Only used when EMBED_PROVIDER=local (HuggingFace model name / path)
EMBED_LOCAL_MODEL=BAAI/bge-small-en-v1.5

# ── Vector DB ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma

# ── SQLite ────────────────────────────────────────────────────────────────────
DB_URL=sqlite:///./data/db.sqlite

# ── Langfuse (Module 7) ───────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
